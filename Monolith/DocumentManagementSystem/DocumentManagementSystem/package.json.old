{
  "name": "dinas-pendidikan",
  "version": "1.0.0",
  "private": true,
  "description": "ASP.NET Core project with jQuery, Bootstrap 5 and Mazer Admin Template",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "install-deps": "npm install && npm run copy-assets",
    //"copy-assets": "copyfiles -f node_modules/mazer/dist/assets/**/* wwwroot/assets/ && copyfiles -f node_modules/bootstrap/dist/js/bootstrap.bundle.min.js wwwroot/js/ && copyfiles -f node_modules/jquery/dist/jquery.min.js wwwroot/js/",
    "copy-assets": "copyfiles -u 1 \"node_modules/mazer/dist/**/*\" \"wwwroot/assets/\" && copyfiles \"node_modules/bootstrap/dist/**/*\" \"wwwroot/libs/bootstrap/\" && copyfiles \"node_modules/jquery/dist/jquery*.js\" \"wwwroot/libs/jquery/\"",
    "clean": "rimraf wwwroot/libs/* wwwroot/css/* wwwroot/js/vendor/*"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "jquery": "^3.7.1",
    "jquery-validation": "^1.19.5",
    "jquery-validation-unobtrusive": "^4.0.0",
    "mazer": "^2.0.0",
    "@popperjs/core": "^2.11.8",
    "font-awesome": "^4.7.0",
    "datatables.net-bs5": "^1.13.6",
    "chart.js": "^4.4.0",
    "sweetalert2": "^11.7.27"
  },
  "devDependencies": {
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "copyfiles": "^3.0.0",
    "rimraf": "^5.0.1",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}