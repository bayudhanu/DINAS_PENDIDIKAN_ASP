@page "/surat-masuk/daftar"
@using DocumentManagementSystem.Models
@using DocumentManagementSystem.Services
@using Microsoft.AspNetCore.Authorization
@inject ISuratMasukService SuratMasukService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<h3>Daftar Surat Masuk</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="TambahSuratMasuk">Tambah Surat Masuk</button>
    <div class="float-right">
        <input type="text" class="form-control" placeholder="Cari surat..." @bind="searchKeyword" />
        <button class="btn btn-secondary" @onclick="Search">Cari</button>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!suratMasukList.Any())
{
    <div class="alert alert-info">
        Tidak ada data surat masuk
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>No. Surat</th>
                <th>Perihal</th>
                <th>Tanggal Surat</th>
                <th>Asal Surat</th>
                <th>Tujuan</th>
                <th>Status</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var surat in suratMasukList)
            {
                <tr>
                    <td>@surat.NomorSurat</td>
                    <td>@surat.Perihal</td>
                    <td>@surat.TanggalSurat.ToShortDateString()</td>
                    <td>@surat.Pengirim</td>
                    <td>@surat.Keterangan</td>
                    <td>@surat.Status</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => ViewSuratMasuk(surat.Id)">Detail</button>
                        <button class="btn btn-sm btn-warning" @onclick="() => EditSuratMasuk(surat.Id)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteSuratMasuk(surat.Id)">Hapus</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SuratMasuk> suratMasukList = new();
    private bool isLoading = true;
    private string searchKeyword = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalSuratMasuk = 0;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        totalSuratMasuk = await SuratMasukService.GetTotalSuratMasuk();
        totalPages = (int)Math.Ceiling((double)totalSuratMasuk / pageSize);

        if (string.IsNullOrWhiteSpace(searchKeyword))
        {
            suratMasukList = (await SuratMasukService.GetAllSuratMasuk())
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        else
        {
            suratMasukList = (await SuratMasukService.SearchSuratMasuk(searchKeyword)).ToList();
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task Search()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadData();
    }

    private void TambahSuratMasuk()
    {
        NavigationManager.NavigateTo("/surat-masuk/tambah");
    }

    private void ViewSuratMasuk(int id)
    {
        NavigationManager.NavigateTo($"/surat-masuk/view/{id}");
    }

    private void EditSuratMasuk(int id)
    {
        NavigationManager.NavigateTo($"/surat-masuk/edit/{id}");
    }

    private async Task DeleteSuratMasuk(int id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Apakah Anda yakin ingin menghapus surat ini?");
        if (confirm)
        {
            await SuratMasukService.DeleteSuratMasuk(id);
            await LoadData();
        }
    }

    private string GetBadgeClass(string sifatSurat)
    {
        return sifatSurat switch
        {
            "Penting" => "bg-warning text-dark",
            "Rahasia" => "bg-danger",
            _ => "bg-primary"
        };
    }
}